# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Anthropic (orchestrator, Sonnet tool-use loop) ----
ANTHROPIC_API_KEY=
ANTHROPIC_ORCHESTRATOR_MODEL=claude-sonnet-5

# ---- Higgsfield REST API (media generation) ----
# Get HIGGSFIELD_API_KEY from cloud.higgsfield.ai -> dashboard -> API
# section. It must be the combined "KEY_ID:KEY_SECRET" string (Higgsfield's
# auth header is "Authorization: Key KEY_ID:KEY_SECRET", not Bearer) --
# verify the value you copy is actually in that format.
# HIGGSFIELD_API_BASE_URL is optional; defaults to
# https://platform.higgsfield.ai if unset. Do NOT point this at an MCP
# server URL (e.g. anything with "/mcp" in it) -- that's a different,
# interactive-agent-only protocol this client doesn't speak. If you
# previously set HIGGSFIELD_MCP_URL, it's no longer read by the code and
# can be deleted.
HIGGSFIELD_API_BASE_URL=
HIGGSFIELD_API_KEY=

# ---- Canva MCP / Connect API (design editing) ----
CANVA_MCP_URL=
CANVA_ACCESS_TOKEN=

# ---- On-chain data (S4 scanner, reuse Qwibi's client if available) ----
MORALIS_API_KEY=
COVALENT_API_KEY=

# ---- OKX exchange API (v5) ----
# From OKX's regular exchange API dashboard (API Key / Secret Key /
# Passphrase), used by lib/clients/okx.ts to confirm the settlement
# currency actually lands in the payout wallet. Separate from OKX Agentic
# Wallet / OnchainOS ASP registration, which is a platform-side setup step,
# not something this app authenticates to directly.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_SETTLEMENT_CURRENCY=USDT

# ---- Storage ----
SUPABASE_STORAGE_BUCKET=quickmotive-assets
