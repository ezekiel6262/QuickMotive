# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Anthropic (orchestrator, Sonnet tool-use loop) ----
ANTHROPIC_API_KEY=
ANTHROPIC_ORCHESTRATOR_MODEL=claude-sonnet-5

# ---- Google Gemini (image generation, gemini-2.5-flash-image / "Nano
# Banana") ----
# Used by S1 (text-to-image), S6, S7, S8, and S10's trait library for all
# image generation -- moved off Higgsfield for this operation on cost
# grounds. Also used by lib/clients/veo.ts (S1 video, S2) for Google Veo
# video generation -- same key, different model. Get a free-tier key at
# aistudio.google.com (no credit card required for the free tier; video
# generation via Veo is NOT free-tier -- see lib/clients/veo.ts for real
# per-second pricing before relying on S2/S1-video for volume).
GEMINI_API_KEY=

# ---- Stability AI Developer Platform (img2img strength, S7 variation
# only) ----
# Get a key at platform.stability.ai -> account -> API Keys. Used
# specifically for S7's strength-based image variation -- Gemini has no
# equivalent img2img strength parameter (see lib/clients/gemini.ts).
# Note: Stability AI "Brand Studio" credits are a separate product from
# the Developer Platform for most account tiers (Brand Studio API access
# is Enterprise-only) -- confirm your key/credits actually work against
# api.stability.ai, not just the Brand Studio web app, before relying on
# this.
STABILITY_API_KEY=

# ---- Canva MCP / Connect API (design editing) ----
CANVA_MCP_URL=
CANVA_ACCESS_TOKEN=

# ---- On-chain data (S4 scanner, reuse Qwibi's client if available) ----
MORALIS_API_KEY=
COVALENT_API_KEY=

# ---- OKX exchange API (v5) ----
# From OKX's regular exchange API dashboard (API Key / Secret Key /
# Passphrase), used by lib/clients/okx.ts to confirm the settlement
# currency actually lands in the payout wallet. Separate from OKX Agentic
# Wallet / OnchainOS ASP registration, which is a platform-side setup step,
# not something this app authenticates to directly.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_SETTLEMENT_CURRENCY=USDT

# Bearer token guarding GET /api/admin/okx-balance, which returns real
# account balances. Unset means the route 404s -- which is the right
# default. Set it only if you actually use the ops check, and treat it as
# a secret: once the app is publicly reachable (which it must be to be
# hireable), Vercel's deployment protection is no longer in front of it.
ADMIN_API_TOKEN=

# ---- Storage ----
SUPABASE_STORAGE_BUCKET=quickmotive-assets

# =====================================================================
# BNB Agent Studio deployment (BNB Chain listing)
# =====================================================================
# Independent of the OKX path above -- the same eleven services are sold
# through both. Leave X402_ENABLED unset and none of this changes any
# existing behavior.

# Public origin of the deployed app. Used to build absolute URLs in the
# agent card and as the ERC-8004 tokenURI base. Must be the real HTTPS
# origin buyers hit, not a preview URL: it is baked into an on-chain
# registration that is awkward to change later.
AGENT_BASE_URL=https://quickmotive.example
AGENT_VERSION=1.0.0
AGENT_PROVIDER_NAME=QuickMotive
AGENT_PROVIDER_URL=

# ---- Pricing ----
# Buyer-facing prices for cost-derived services (currently S2 and S1's
# video path) are computed as provider cost x (1 + PRICE_MARGIN). The
# margin has to cover more than the provider invoice: Supabase storage and
# egress, the Anthropic planning calls, and generations that are paid for
# but fail QC. `npm run verify:pricing` fails if any price stops covering
# its cost, so change these here rather than editing prices by hand.
PRICE_MARGIN=0.6

# Worst-case provider costs, USD per unit. Defaults are the figures
# documented in lib/clients/veo.ts; override if Google's pricing moves.
COST_VEO_FAST_PER_SECOND=0.15
COST_VEO_STANDARD_PER_SECOND=0.4

# ---- x402 / b402 payments ----
# Master switch. Unset or "false" makes every payment gate a no-op, which
# is the state the OKX A2MCP deployment runs in.
X402_ENABLED=false

# Where settlement lands. Required whenever X402_ENABLED=true.
AGENT_PAYOUT_ADDRESS=

# bsc-mainnet (default) or bsc-testnet.
B402_NETWORK=bsc-mainnet

# b402 facilitator that verifies signatures and broadcasts settlement.
# Default is the public one; B402_FACILITATOR_API_KEY is only needed if
# yours requires auth.
B402_FACILITATOR_URL=https://facilitator.b402.ai
B402_FACILITATOR_API_KEY=

# Settlement tokens quoted in the 402 `accepts` list, in preference order.
# Prices in lib/a2mcp/registry.ts are USD-denominated, so only add
# USD-pegged stablecoins here.
B402_ACCEPTED_CURRENCIES=USDT,USDC

# Overrides the token table in lib/chains/bnb.ts entirely. Needed on
# testnet (no canonical stablecoin set) or for a token not yet listed
# there. Decimals matter: BEP-20 USDT/USDC are 18, not 6.
B402_ASSET_ADDRESS=
B402_ASSET_DECIMALS=18

# How long a payment authorization stays valid, seconds.
B402_MAX_TIMEOUT_SECONDS=300

# ---- ERC-8004 on-chain agent identity ----
# The Identity Registry on BSC. No default on purpose -- ERC-8004's
# canonical addresses differ per chain and have changed between draft
# revisions, and `npm run agent:register` sends a real transaction to
# whatever sits here. Read it off the ERC-8004 deployment table and
# verify it on BscScan first.
ERC8004_IDENTITY_REGISTRY=

# Set AFTER a successful `npm run agent:register`, from the agentId it
# prints. Until both this and the registry above are set, the agent card
# advertises an empty `registrations` list -- accurate, since nothing is
# registered yet.
ERC8004_AGENT_ID=

# The agent's own wallet: the address that owns the registration, and the
# private key that signs the registration transaction. The key is used
# only by scripts/register-agent.ts (never at request time) -- keep it out
# of the deployed app's environment.
AGENT_WALLET_ADDRESS=
AGENT_PRIVATE_KEY=

# RPC used by the registration script. Defaults to the public BSC
# dataseed, which rate-limits; use a private endpoint for anything beyond
# a one-off registration.
BSC_RPC_URL=

# ---- Internal calls ----
# Lets the orchestrator call its own service routes past the payment gate.
# Anyone holding it calls every priced service for free, so treat it as a
# real secret. The orchestrator is refused entirely while X402_ENABLED=true
# unless ORCHESTRATOR_ALLOW_UNPAID=true, because it is not itself metered.
INTERNAL_SERVICE_TOKEN=
ORCHESTRATOR_ALLOW_UNPAID=false
